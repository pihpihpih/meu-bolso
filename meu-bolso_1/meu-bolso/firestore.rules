rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMember(sid) {
      return signedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/sheets/$(sid)).data.members;
    }

    // Perfil de cada pessoa (qual planilha usa, tema)
    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    // Planilha (pode ser compartilhada entre várias pessoas)
    match /sheets/{sid} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;

      allow create: if signedIn()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.members == [request.auth.uid];

      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'names', 'inviteOpen'])
        && (
          // quem já é membro pode mudar nomes, convite e membros
          request.auth.uid in resource.data.members
          ||
          // quem tem o link pode entrar (só se adicionando), se o convite estiver aberto
          (resource.data.inviteOpen == true
            && request.resource.data.inviteOpen == true
            && request.resource.data.members.hasAll(resource.data.members)
            && request.resource.data.members.size() == resource.data.members.size() + 1
            && request.auth.uid in request.resource.data.members)
        );

      // Lançamentos, gastos fixos e ajustes: só membros
      match /{document=**} {
        allow read, write: if isMember(sid);
      }
    }
  }
}
